RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string   # dashboard > Webhooks: {PUBLIC_URL}/webhook/razorpay, events payment.captured + order.paid
PUBLIC_URL=https://your-public-url                     # needed for the webhook (ngrok / cloudflared tunnel is fine)
AUTO_TINYFISH=0                                        # once Razorpay works: unpaid charges wait for the driver
# --- Reminders ---
REMIND_MINS=30                                         # e-mail/SMS a driver once when a charge has been pending this long
SMTP_HOST=smtp.example.com
SMTP_USER=
SMTP_PASS=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+1xxxxxxxxxx                               # SMS reminders reuse the guard-call Twilio settings
REMIND_SMS=1
# --- Live-session safety net ---
SNAP_EVERY=5                                           # seconds between snapshots of who is parked (billed on next start if the app stopped)
TINYFISH_API_KEY=
